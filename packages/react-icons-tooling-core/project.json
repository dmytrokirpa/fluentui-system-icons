{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "react-icons-tooling-core",
  "projectType": "library",
  "sourceRoot": "packages/react-icons-tooling-core/src",
  "tags": ["npm:standalone"],
  "targets": {
    "build": {
      "dependsOn": [],
      "cache": true,
      "inputs": [
        "default",
        "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
        "!{projectRoot}/test/**",
        "!{projectRoot}/bench/**"
      ],
      "outputs": ["{projectRoot}/lib"]
    },
    "test": {
      "dependsOn": ["build"]
    }
  }
}
