{
  "name": "@fluentui/react-icons-svg-sprite-subsetting-webpack-plugin",
  "version": "0.0.7",
  "description": "Webpack plugin to subset or merge SVG sprite assets used by @fluentui/react-icons svg-sprite APIs.",
  "main": "lib/index.js",
  "scripts": {
    "test": "yarn test:validation && node test/run.js --bundler all",
    "test:atomic": "yarn run -T webpack -c test/webpack.config.js",
    "test:merged": "SVG_SPRITE_MODE=merged SVG_SPRITE_MERGED_FILENAME='fluentui-react-icons.[contenthash].svg' yarn run -T webpack -c test/webpack.config.js",
    "test:manifest": "SVG_SPRITE_MANIFEST=1 yarn run -T webpack -c test/webpack.config.js",
    "test:inline": "SVG_SPRITE_INJECT=inline yarn run -T webpack -c test/webpack.config.js",
    "test:reference": "SVG_SPRITE_MODE=merged SVG_SPRITE_INJECT=reference yarn run -T webpack -c test/webpack.config.js",
    "test:groups": "SVG_SPRITE_GROUPS=1 SVG_SPRITE_INJECT=inline yarn run -T webpack -c test/webpack.config.js",
    "test:webpack": "node test/run.js --bundler webpack",
    "test:rspack": "node test/run.js --bundler rspack",
    "test:validation": "node test/validation.js",
    "build": "node scripts/build",
    "lint": "yarn run -T eslint package.json",
    "type-check:infra": "yarn run -T tsc -p ./scripts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/microsoft/fluentui-system-icons.git",
    "directory": "packages/react-icons-svg-sprite-subsetting-webpack-plugin"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/microsoft/fluentui-system-icons/issues"
  },
  "homepage": "https://github.com/microsoft/fluentui-system-icons/tree/main/packages/react-icons-svg-sprite-subsetting-webpack-plugin#readme",
  "dependencies": {
    "@fluentui/react-icons-tooling-core": "*",
    "schema-utils": "^4.2.0"
  },
  "devDependencies": {
    "@fluentui/react-icons": "*"
  },
  "peerDependencies": {
    "@rspack/core": ">=2.0.0",
    "webpack": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@rspack/core": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "files": [
    "lib/*"
  ]
}
